# Anthropic API（必須）
# APIキーはサーバー側のみで使用し、フロントエンドには一切渡さない。
ANTHROPIC_API_KEY=
# 省略時は claude-sonnet-5 を使用
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase（任意・未設定でもAPIは動作するが結果は保存されない）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# アクセスゲート（任意・未設定だと誰でもアクセスできてしまうため本番では必須）
# 運営者用マスターコード。/admin（案件管理）や、コード発行前の画面確認に使う。
# 顧客（対象者）は、/admin で案件を作成すると発行される固有コード（/enter/<code>）を
# メールで受け取って使うため、これとは別物。
ACCESS_CODE=
