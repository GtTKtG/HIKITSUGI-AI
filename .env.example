# Anthropic API（必須）
# APIキーはサーバー側のみで使用し、フロントエンドには一切渡さない。
ANTHROPIC_API_KEY=
# 省略時は claude-sonnet-5 を使用
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase（任意・未設定でもAPIは動作するが結果は保存されない）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 簡易アクセスゲート（任意・未設定だと誰でもアクセスできてしまうため本番では必須）
# 運営者・対象者で共有する合言葉。/login で入力させ、Cookieでアクセスを許可する。
ACCESS_CODE=
